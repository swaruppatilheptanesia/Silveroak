# ============================================
# SOU T&P Portal — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.

# ── Tenant Configuration ──
# Set the active tenant slug (used for multi-university mode).
# Default: "sou" (Silver Oak University)
VITE_TENANT_SLUG=sou

# ── API Configuration ──
# Base URL for the backend API (Node.js/Express backend)
VITE_API_BASE_URL=https://silveroak.heptanesia.com/api

# ── Feature Flags (optional overrides) ──
# VITE_ENABLE_PORTFOLIO=true
# VITE_ENABLE_NOC=true
# VITE_ENABLE_CIRCULARS=true
