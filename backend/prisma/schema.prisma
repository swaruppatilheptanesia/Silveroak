// ============================================================
// EVENTS
// ============================================================

model Event {
  id                   String      @id @default(uuid())
  tenant_id            String
  company_id           String
  // Legacy single linked posting — kept as a back-compat MIRROR = posting_ids[0].
  // Multiple linked postings/roles now live in posting_ids (below); consumers that read
  // the single `posting` relation still work (they see the first linked posting).
  posting_id           String?
  // All linked postings (roles) for this event. App-managed ids (no FK relation on arrays).
  posting_ids          String[]    @default([])
  title                String      @db.VarChar(300)
  type                 String      @db.VarChar(150)
  status               EventStatus @default(draft)
  date                 DateTime    @db.Date
  start_time           String      @db.VarChar(10)
  end_time             String      @db.VarChar(10)
  venue                String      @db.VarChar(300)
  reporting_time       String?     @db.VarChar(10)
  dress_code           String?     @db.VarChar(200)
  instructions         String?     @db.Text
  documents_required   String[]    @default([])
  faculty_coordinators String[]    @default([])
  // Faculty coordinator USER ids (identity link; drives faculty event visibility). Legacy-mirror
  // alongside faculty_coordinators (display names). Empty on pre-migration events.
  faculty_coordinator_ids String[] @default([])
  // "Pipeline" audience scope — when set, matching students are auto-assigned as
  // EventStudent rows on create/update (add-only). Empty = manual assignment only.
  target_institutes    String[]    @default([])
  target_courses       String[]    @default([])
  target_branches      String[]    @default([])
  // Application-pipeline-stage eligibility: when set, only students whose CURRENT application
  // stage on a linked posting matches this stage are auto-assigned (snapshot at create/update,
  // add-only). Null = no stage filter (all applicants of the linked postings). Grandfathers
  // existing events.
  application_stage    ApplicationStage?
  created_by           String?
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company           Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  posting           Posting?       @relation("EventPosting", fields: [posting_id], references: [id])
  created_by_user   User?          @relation("EventCreatedBy", fields: [created_by], references: [id])
  panels            EventPanel[]
  assigned_students EventStudent[]

  @@index([tenant_id, date])
  @@index([tenant_id, status])
  @@index([company_id])
  @@map("events")
}

// ============================================================
// EVENT PANELS
// ============================================================

model EventPanel {
  id         String   @id @default(uuid())
  event_id   String
  panel_name String   @db.VarChar(100)
  room       String   @db.VarChar(100)
  start_time String?  @db.VarChar(10)
  end_time   String?  @db.VarChar(10)
  recruiters String[] @default([])
  created_at DateTime @default(now())

  event    Event          @relation(fields: [event_id], references: [id], onDelete: Cascade)
  students EventStudent[]

  @@index([event_id])
  @@map("event_panels")
}

// ============================================================
// EVENT STUDENTS (Junction)
// ============================================================

model EventStudent {
