  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, is_active])
  @@map("eligibility_rules")
}

// ============================================================
// MASTER OPTIONS
// ============================================================

model MasterOption {
  id               String         @id @default(uuid())
  tenant_id        String
  category         MasterCategory
  value            String         @db.VarChar(150)
  normalized_value String         @db.VarChar(150)
  target_institutes String[]      @default([])
  target_courses   String[]       @default([])
  target_branches  String[]       @default([])
  target_semesters  String[]       @default([])
  target_academic_years String[]  @default([])
  is_active        Boolean        @default(true)
  // posting_type only: when false the type stays VISIBLE to students but its Register/apply
  // actions are blocked. Independent of is_active (which hides the type entirely).
  accepting_applications Boolean   @default(true)
  created_by       String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  tenant          Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_by_user User?  @relation("MasterOptionCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  noc_templates   NocTemplate[]
  postings_using_as_type Posting[] @relation("PostingTypeOption")
  policies_using_as_type Policy[] @relation("PolicyPostingType")
  student_posting_type_preferences StudentPostingTypePreference[] @relation("PostingTypePreference")

  @@unique([tenant_id, category, normalized_value])
  @@index([tenant_id, category, is_active])
  @@map("master_options")
}

// ============================================================
// NOC TEMPLATES
// ============================================================

model NocTemplate {
  id                     String   @id @default(uuid())
  tenant_id              String
  posting_type_master_id String
  branch_scope           String   @default("ALL") @db.VarChar(200)
  name                   String   @db.VarChar(200)
  subject                String   @db.Text
  body_html              String   @db.Text
  created_by             String?
  updated_by             String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  tenant              Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  posting_type_master MasterOption @relation(fields: [posting_type_master_id], references: [id], onDelete: Cascade)
  created_by_user     User?        @relation("NocTemplateCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updated_by_user     User?        @relation("NocTemplateUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  noc_requests        NocRequest[]

  @@unique([tenant_id, posting_type_master_id, branch_scope])
  @@index([tenant_id])
  @@map("noc_templates")
}

// ============================================================
// EXPORT RECORDS
// ============================================================

model ExportRecord {
  id              String       @id @default(uuid())
  tenant_id       String
  posting_id      String?
  company_name    String?      @db.VarChar(300)
  role_name       String?      @db.VarChar(200)
  exported_by     String
  format          ExportFormat
  record_count    Int
  fields_included String[]     @default([])
  exported_at     DateTime     @default(now())

  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  posting          Posting? @relation(fields: [posting_id], references: [id])
  exported_by_user User     @relation("ExportedBy", fields: [exported_by], references: [id])

  @@index([tenant_id])
  @@map("export_records")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String
  user_id     String?
  user_name   String?  @db.VarChar(200)
  action      String   @db.VarChar(50)
  module      String   @db.VarChar(50)
  target_type String?  @db.VarChar(50)
  target_id   String?
  details     String?  @db.Text
  ip_address  String?  @db.VarChar(50)
  created_at  DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?  @relation("AuditUser", fields: [user_id], references: [id])

  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, module])
  @@index([tenant_id, action])
  @@index([user_id])
  @@map("audit_logs")
}

// ============================================================
// ROLE PERMISSIONS
// ============================================================

model RolePermission {
  id          String   @id @default(uuid())
  tenant_id   String
  role        String   @db.VarChar(30)
  module      String   @db.VarChar(50)
  can_view    Boolean  @default(false)
  can_create  Boolean  @default(false)
  can_edit    Boolean  @default(false)
  can_delete  Boolean  @default(false)
  can_export  Boolean  @default(false)
  can_approve Boolean  @default(false)
  updated_at  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, role, module])
  @@map("role_permissions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String               @id @default(uuid())
  tenant_id   String
  user_id     String
  type        NotificationType
  title       String               @db.VarChar(300)
  description String?              @db.Text
  priority    NotificationPriority @default(low)
  action_url  String?              @db.Text
  payload     Json?
  is_read     Boolean              @default(false)
  created_at  DateTime             @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([user_id, created_at(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id         String           @id @default(uuid())
  user_id    String
  category   NotificationType
  enabled    Boolean          @default(true)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category])
  @@index([user_id])
  @@map("notification_preferences")
}

// ============================================================
// REFRESH TOKENS
// ============================================================

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique @db.VarChar(500)
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@map("refresh_tokens")
}
