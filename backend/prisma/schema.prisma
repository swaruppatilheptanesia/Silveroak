  student       Student                   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  posting       Posting                   @relation(fields: [posting_id], references: [id], onDelete: Cascade)
  resume        Resume?                   @relation(fields: [resume_id], references: [id])
