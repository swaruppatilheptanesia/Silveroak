generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS - Core
// ============================================================

enum UserRole {
  student
  tpo_admin
  tpo_employee
  faculty_coordinator
  recruiter
  management
  super_admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum InterestType {
  placement
  summer_internship
  winter_internship
  final_semester_internship
  nep_internship
  stipend_internship
  dissertation
}

enum MasterCategory {
  technology
  skill
  interest
  branch
  academic_year
  policy_category
  noc_type
  posting_type
  event_type
}

// ============================================================
// ENUMS - Business
// ============================================================

enum CompanyStatus {
  active
  inactive
}

enum CompanyClassification {
  preferred
  normal
  blacklisted
}

enum CompanySource {
  admin
  student
  recruiter
  import
}

enum EngagementType {
  placement
  internship
  campus_visit
  guest_lecture
  workshop
}

enum WorkMode {
  onsite
  remote
  hybrid
}

enum PostingStatus {
  draft
  published
  closed
}

enum ApplicationStage {
  applied
  mock_round
  shortlisted
  test_scheduled
  interview
  hr_round
  offer_released
  rejected
}

enum MockRoundResult {
  pending
  passed
  failed
}

enum FeedbackDecision {
  shortlist
  under_consideration
  not_selected
}

enum OfferType {
  job
  internship
}

enum OfferStatus {
  pending_student_action
  accepted
  rejected_by_admin
  rejected_by_student
}

enum JoiningStatus {
  pending
  joined
  did_not_join
}

enum ComplianceStatus {
  compliant
  blocked
  override_enabled
}

enum EventStatus {
  draft
  published
  ongoing
  completed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
}

enum NocType {
  internship
  training
  project
}

enum PlacementSource {
  university_drive
  self_sourced
}

enum NocStatus {
  pending_faculty
  pending_tpo
  pending_company_verification
  approved
  issued
  rejected
}

enum CompanyVerificationStatus {
  verified
  pending
  rejected
}

enum CompletionCertStatus {
  pending
  approved
  rejected
}

enum InternshipType {
  paid
  unpaid
  stipend_based
}

enum InternshipStatus {
  ongoing
  completed
  discontinued
}

// ============================================================
// TENANT
// ============================================================

model Tenant {
  id            String   @id @default(uuid())
  slug          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(200)
  short_name    String?  @db.VarChar(50)
  logo_url      String?  @db.Text
  tagline       String?  @db.Text
  contact_email String?  @db.VarChar(255)
  contact_phone String?  @db.VarChar(20)
  website       String?  @db.Text
  config        Json     @default("{}")
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  users               User[]
  students            Student[]
  companies           Company[]
  postings            Posting[]
  events              Event[]
  noc_requests        NocRequest[]
  internships         Internship[]
  announcements       Announcement[]
  circular_templates  CircularTemplate[]
  generated_circulars GeneratedCircular[]
  noc_templates       NocTemplate[]
  no_dues_requests    NoDuesRequest[]
  policies            Policy[]
  eligibility_rules   EligibilityRule[]
  export_records      ExportRecord[]
  audit_logs          AuditLog[]
  role_permissions    RolePermission[]
  master_options      MasterOption[]
  notifications       Notification[]

  @@map("tenants")
}

// ============================================================
// USER
// ============================================================

model User {
  id            String    @id @default(uuid())
  tenant_id     String
  email         String    @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  role          UserRole
  name          String    @db.VarChar(200)
  phone         String?   @db.VarChar(20)
  department    String?   @db.VarChar(100)
  designation   String?   @db.VarChar(100)
  crm_employee_code String? @db.VarChar(50)
  institutes    String[]  @default([])
  courses       String[]  @default([])
  branches      String[]  @default([])
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  student Student?

  verified_students      Student[]                 @relation("VerifiedBy")
  created_postings       Posting[]                 @relation("PostingCreatedBy")
  created_engagements    CompanyEngagement[]       @relation("EngagementCreatedBy")
  stage_changes          ApplicationStageHistory[] @relation("StageChangedBy")
  offer_rejections       Offer[]                   @relation("OfferRejectedBy")
  offer_creations        Offer[]                   @relation("OfferCreatedBy")
  offer_audit_actions    OfferAudit[]              @relation("AuditPerformedBy")
  created_events         Event[]                   @relation("EventCreatedBy")
  attendance_marks       EventStudent[]            @relation("AttendanceMarkedBy")
  noc_faculty_approvals  NocRequest[]              @relation("NocFacultyApprovedBy")
  noc_tpo_approvals      NocRequest[]              @relation("NocTpoApprovedBy")
  verified_recruiters    Recruiter[]               @relation("RecruiterVerifiedBy")
  recruiter_profile      Recruiter?                @relation("RecruiterUser")
  reported_issues        InternshipIssue[]         @relation("IssueReportedBy")
  created_announcements  Announcement[]            @relation("AnnouncementCreatedBy")
  created_templates      CircularTemplate[]        @relation("TemplateCreatedBy")
  created_noc_templates  NocTemplate[]             @relation("NocTemplateCreatedBy")
  updated_noc_templates  NocTemplate[]             @relation("NocTemplateUpdatedBy")
  generated_circulars    GeneratedCircular[]       @relation("CircularGeneratedBy")
  ndc_reviews            NoDuesRequest[]           @relation("NdcReviewedBy")
  exported_records       ExportRecord[]            @relation("ExportedBy")
  audit_logs             AuditLog[]                @relation("AuditUser")
  notifications             Notification[]
  notification_preferences  NotificationPreference[]
  refresh_tokens            RefreshToken[]
  created_master_options    MasterOption[]            @relation("MasterOptionCreatedBy")

  @@unique([tenant_id, email])
  @@unique([tenant_id, crm_employee_code])
  @@index([tenant_id, role])
  @@index([tenant_id, is_active])
  @@map("users")
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id                            String             @id @default(uuid())
  user_id                       String             @unique
  tenant_id                     String
  enrollment_number             String             @db.VarChar(50)
  roll_number                   String?            @db.VarChar(50)
  full_name                     String             @db.VarChar(200)
  email                         String             @db.VarChar(255)
  mobile                        String?            @db.VarChar(20)
  date_of_birth                 DateTime?          @db.Date
  gender                        String?            @db.VarChar(20)
  category                      String?            @db.VarChar(50)
  aadhaar_number                String?            @db.VarChar(20)
  department                    String             @db.VarChar(100)
  batch                         String             @db.VarChar(20)
  course                        String?            @db.VarChar(100)
  institute                     String?            @db.VarChar(200)
  temporary_enrolment_no        String?            @db.VarChar(50)
  parent_name                   String?            @db.VarChar(200)
  parent_contact_no             String?            @db.VarChar(20)
  blood_group                   String?            @db.VarChar(20)
  program_name                  String?            @db.VarChar(100)
  admission_year                Int?
  current_semester              String?            @db.VarChar(50)
  current_semester_spi          Decimal?           @db.Decimal(4, 2)
  current_semester_cpi          Decimal?           @db.Decimal(4, 2)
  current_semester_cgpa         Decimal?           @db.Decimal(4, 2)
  exam_form_status              String?            @db.VarChar(100)
  overall_attendance_percentage Decimal?           @db.Decimal(5, 2)
  board10                       String?            @db.VarChar(200)
  passing_year10                Int?
  board12_or_diploma            String?            @db.VarChar(200)
  passing_year12_or_diploma     Int?
  linkedin_url                  String?            @db.Text
  alternate_phone               String?            @db.VarChar(20)
  residential_address           String?            @db.Text
  permanent_address             String?            @db.Text
  profile_photo_url             String?            @db.Text
  profile_blocked               Boolean            @default(false)
  profile_block_reason          String?            @db.Text
  profile_completion_percentage Int                @default(0)
  verification_status           VerificationStatus @default(pending)
  verification_remarks          String?            @db.Text
  verified_by                   String?
  verified_at                   DateTime?
  policy_accepted               Boolean            @default(false)
  policy_accepted_at            DateTime?
  no_dues_enabled               Boolean            @default(false)
  placement_opt_out             Boolean            @default(false)
  placement_opt_out_reason      String?            @db.Text
  placement_opt_out_at          DateTime?
  created_at                    DateTime           @default(now())
  updated_at                    DateTime           @updatedAt

  // Relations
  user             User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant           Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  verified_by_user User?  @relation("VerifiedBy", fields: [verified_by], references: [id])

  academic_profile       AcademicProfile?
  skills_profile         SkillsProfile?
  employments            CurrentEmployment[]
  projects               StudentProject[]
  certifications         Certification[]
  resumes                Resume[]
  policy_acceptances     PolicyAcceptance[]
  interest_registrations InterestRegistration[]
  posting_type_preferences StudentPostingTypePreference[]
  placement_pref_history StudentPlacementPreferenceHistory[]
  applications           Application[]
  offers                 Offer[]
  event_assignments      EventStudent[]
  noc_requests           NocRequest[]
  internships            Internship[]
  portfolio              Portfolio?
  announcement_receipts  AnnouncementReceipt[]
  no_dues_requests       NoDuesRequest[]

  @@unique([tenant_id, enrollment_number])
  @@index([tenant_id, department])
  @@index([tenant_id, batch])
  @@index([tenant_id, verification_status])
  @@index([tenant_id, profile_blocked])
  @@index([tenant_id, no_dues_enabled])
  @@index([profile_completion_percentage])
  @@map("students")
}

// ============================================================
// PLACEMENT PREFERENCES (per-posting-type opt-out)
// ============================================================

// Per-(student, posting type) interest flag. Absence of a row = interested (default true).
// interested=false means the student opted out of that posting type and cannot apply / register interest.
model StudentPostingTypePreference {
  id                     String   @id @default(uuid())
  student_id             String
  posting_type_master_id String
  interested             Boolean  @default(true)
  reason                 String?  @db.Text
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  student             Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  posting_type_master MasterOption @relation("PostingTypePreference", fields: [posting_type_master_id], references: [id], onDelete: Cascade)

  @@unique([student_id, posting_type_master_id])
  @@index([student_id])
  @@map("student_posting_type_preferences")
}

// Append-only history of every enable/disable (global or per posting type). Stores a label
// snapshot + plain posting_type_master_id (no FK) so history survives a posting-type rename/delete.
model StudentPlacementPreferenceHistory {
  id                     String   @id @default(uuid())
  tenant_id              String
  student_id             String
  scope                  String   @db.VarChar(20) // 'global' | 'posting_type'
  posting_type_master_id String?
  posting_type_label     String?  @db.VarChar(150)
  interested             Boolean
  reason                 String?  @db.Text
  created_at             DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, created_at(sort: Desc)])
  @@map("student_placement_preference_history")
}

// ============================================================
// ACADEMIC PROFILE
// ============================================================

model AcademicProfile {
  id                 String   @id @default(uuid())
  student_id         String   @unique
  cgpa               Decimal? @db.Decimal(4, 2)
  tenth_percentage   Decimal? @db.Decimal(5, 2)
  twelfth_percentage Decimal? @db.Decimal(5, 2)
  diploma_percentage Decimal? @db.Decimal(5, 2)
  backlog_count      Int      @default(0)
  active_backlogs    Int      @default(0)
  semester           Int?
  year_of_study      Int?
  course_duration    Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("academic_profiles")
}

// ============================================================
// SKILLS PROFILE
// ============================================================

model SkillsProfile {
  id                  String   @id @default(uuid())
  student_id          String   @unique
  technical_skills    String[] @default([])
  domain_interests    String[] @default([])
  preferred_locations String[] @default([])
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("skills_profiles")
}

// ============================================================
// STUDENT PROJECTS
// ============================================================

model StudentProject {
  id           String    @id @default(uuid())
  student_id   String
  portfolio_id String?
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  role         String?   @db.VarChar(200)
  technologies String[]  @default([])
  keywords     String[]  @default([])
  github_url   String?   @db.Text
  demo_url     String?   @db.Text
  live_url     String?   @db.Text
  start_date   DateTime? @db.Date
  end_date     DateTime? @db.Date
  is_ongoing   Boolean   @default(false)
  attachments  Json      @default("[]")
  display_order Int      @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  portfolio Portfolio? @relation("StudentPortfolioProjects", fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([portfolio_id])
  @@map("student_projects")
}

// ============================================================
// CERTIFICATIONS
// ============================================================

model Certification {
  id                  String    @id @default(uuid())
  student_id          String
  name                String    @db.VarChar(200)
  issuer              String    @db.VarChar(200)
  issue_date          DateTime? @db.Date
  credential_url      String?   @db.Text
  document_url        String?   @db.Text
  document_name       String?   @db.VarChar(255)
  document_mime_type  String?   @db.VarChar(150)
  document_size       Int?
  created_at          DateTime  @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@map("certifications")
}

// ============================================================
// RESUMES
// ============================================================

model Resume {
  id          String   @id @default(uuid())
  student_id  String
  name        String   @db.VarChar(200)
  file_url    String   @db.Text
  file_size   Int?
  mime_type   String?  @db.VarChar(50)
  is_default  Boolean  @default(false)
  ai_score    Int?
  uploaded_at DateTime @default(now())

  student      Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([student_id])
  @@map("resumes")
}

// ============================================================
// CURRENT EMPLOYMENT
// ============================================================

// Now a LIST per student (multiple employment entries). Each entry is 'active' or 'closed';
// closing requires a mandatory completion-proof document. `is_currently_working` is kept = (status === 'active')
// for back-compat with admin display. `offer_letter_url`/`business_proof_url` are legacy (unused by new UI).
model CurrentEmployment {
  id                    String    @id @default(uuid())
  student_id            String
  is_currently_working  Boolean   @default(false)
  employment_type       String?   @db.VarChar(50)
  company_name          String?   @db.VarChar(200)
  designation           String?   @db.VarChar(200)
  package_lpa           Decimal?  @db.Decimal(10, 2)
  status                String    @default("active") @db.VarChar(20)
  closed_at             DateTime?
  completion_proof_url  String?   @db.Text
  completion_proof_name String?   @db.VarChar(255)
  offer_letter_url      String?   @db.Text
  business_proof_url    String?   @db.Text
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@map("current_employment")
}

// ============================================================
// POLICY ACCEPTANCES
// ============================================================

model PolicyAcceptance {
  id                      String   @id @default(uuid())
  student_id              String
  policy_id               String?
  policy_version          String?  @db.VarChar(20)
  policy_updated_at       DateTime?
  policy_read             Boolean  @default(false)
  rules_accepted          Boolean  @default(false)
  profile_sharing_consent Boolean  @default(false)
  resume_sharing_consent  Boolean  @default(false)
  data_storage_consent    Boolean  @default(false)
  communication_consent   Boolean  @default(false)
  accepted_at             DateTime @default(now())
  ip_address              String?  @db.VarChar(50)

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  policy  Policy? @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([policy_id])
  @@index([student_id, policy_id])
  @@map("policy_acceptances")
}

// ============================================================
// INTEREST REGISTRATIONS
// ============================================================

enum InterestRegistrationStatus {
  pending
  approved
  withdrawn
}

model InterestRegistration {
  id            String                     @id @default(uuid())
  student_id    String
  interest_type String                     @db.Text
  registered_at DateTime                   @default(now())
  status        InterestRegistrationStatus @default(approved)
  reviewed_by   String?
  reviewed_by_name String?
  reviewed_at   DateTime?
  status_reason String?                    @db.Text

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, interest_type])
  @@index([student_id, status])
  @@map("interest_registrations")
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id                  String                    @id @default(uuid())
  tenant_id           String
  name                String                    @db.VarChar(300)
  industry            String?                   @db.VarChar(100)
  address             String?                   @db.Text
  website             String?                   @db.Text
  description         String?                   @db.Text
  city                String?                   @db.VarChar(100)
  state               String?                   @db.VarChar(100)
  pan                 String?                   @db.VarChar(20)
  gst                 String?                   @db.VarChar(30)
  source              CompanySource             @default(admin)
  verification_status CompanyVerificationStatus @default(verified)
  status              CompanyStatus             @default(active)
  classification      CompanyClassification     @default(normal)
  internal_remarks    String?                   @db.Text
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  recruiters          Recruiter[]
  engagements         CompanyEngagement[]
  postings            Posting[]
  offers              Offer[]
  events              Event[]
  internships         Internship[]
  generated_circulars GeneratedCircular[]
  noc_requests        NocRequest[]

  @@index([tenant_id, name])
  @@index([tenant_id, status])
  @@index([tenant_id, classification])
  @@map("companies")
}

// ============================================================
// RECRUITERS
// ============================================================

model Recruiter {
  id                  String             @id @default(uuid())
  user_id             String?            @unique
  company_id          String
  tenant_id           String
  name                String             @db.VarChar(200)
  email               String             @db.VarChar(255)
  phone               String?            @db.VarChar(20)
  designation         String?            @db.VarChar(100)
  verification_status VerificationStatus @default(pending)
  verified_by         String?
  verified_at         DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user             User?               @relation("RecruiterUser", fields: [user_id], references: [id])
  company          Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  verified_by_user User?               @relation("RecruiterVerifiedBy", fields: [verified_by], references: [id])
  feedback         RecruiterFeedback[]

  @@unique([tenant_id, email])
  @@index([company_id])
  @@index([verification_status])
  @@map("recruiters")
}

// ============================================================
// COMPANY ENGAGEMENTS
// ============================================================

model CompanyEngagement {
  id               String         @id @default(uuid())
  company_id       String
  tenant_id        String
  visitor_type     EngagementType
  date             DateTime       @db.Date
  remarks          String?        @db.Text
  students_hired   Int            @default(0)
  packages_offered String?        @db.Text
  academic_year    String?        @db.VarChar(20)
  created_by       String?

  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_by_user User?    @relation("EngagementCreatedBy", fields: [created_by], references: [id])
  created_at      DateTime @default(now())

  @@index([company_id])
  @@map("company_engagements")
}

// ============================================================
// POSTINGS (Job / Internship)
// ============================================================

model Posting {
  id                     String        @id @default(uuid())
  tenant_id              String
  company_id             String
  title                  String        @db.VarChar(200)
  posting_type_master_id String
  academic_year          String        @db.VarChar(20)
  role_name              String        @db.VarChar(200)
  location               String        @db.VarChar(200)
  locations              String[]      @default([])
  work_mode              WorkMode
  ctc                    String?       @db.VarChar(100)
  stipend                String?       @db.VarChar(100)
  duration               String?       @db.VarChar(100)
  bond_details           String?       @db.Text
  role_description       String?       @db.Text
  job_description_pdf_url String?      @db.Text
  job_description_pdf_urls String[]    @default([])
  job_description_pdf_names String[]   @default([])
  target_institutes      String[]      @default([])
  target_courses         String[]      @default([])
  target_branches        String[]      @default([])
  target_semesters       String[]      @default([])
  eligible_branches      String[]      @default([])
  eligible_batches       String[]      @default([])
  min_cgpa               Decimal       @default(0) @db.Decimal(4, 2)
  max_backlogs           Int           @default(0)
  skill_requirements     String?       @db.Text
  has_written_test       Boolean       @default(false)
  written_test_details   String?       @db.Text
  has_gd                 Boolean       @default(false)
  gd_details             String?       @db.Text
  technical_rounds       Int           @default(0)
  hr_rounds              Int           @default(0)
  additional_info        String?       @db.Text
  application_override_enabled Boolean @default(false)
  application_start_date DateTime?     @db.Date
  application_end_date   DateTime?     @db.Date
  status                 PostingStatus @default(draft)
  published_at           DateTime?
  closed_at              DateTime?
  created_by             String?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  tenant               Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company              Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  posting_type_master  MasterOption   @relation("PostingTypeOption", fields: [posting_type_master_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_by_user      User?          @relation("PostingCreatedBy", fields: [created_by], references: [id])
  applications         Application[]
  offers               Offer[]
  events               Event[]        @relation("EventPosting")
  target_announcements Announcement[] @relation("AnnouncementTargetPosting")
  export_records       ExportRecord[]

  @@index([tenant_id, status])
  @@index([tenant_id, posting_type_master_id])
  @@index([company_id])
  @@index([tenant_id, academic_year])
  @@map("postings")
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id                String           @id @default(uuid())
  tenant_id         String
  student_id        String
  posting_id        String
  resume_id         String?
  current_stage     ApplicationStage @default(applied)
