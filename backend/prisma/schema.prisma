  @@index([internship_id])
  @@map("internship_issues")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id                   String               @id @default(uuid())
  tenant_id            String
  title                String               @db.VarChar(200)
  content              String               @db.Text
  priority             AnnouncementPriority @default(medium)
  status               AnnouncementStatus   @default(draft)
  target_audience_type TargetAudienceType   @default(all)
  target_institutes    String[]             @default([])
  target_courses       String[]             @default([])
  target_branches      String[]             @default([])
  target_batches       String[]             @default([])
  target_departments   String[]             @default([])
  target_semesters     String[]             @default([])
  target_posting_id    String?
  requires_consent     Boolean              @default(false)
  attachment_url       String?              @db.Text
  attachment_name      String?              @db.VarChar(255)
  attachment_mime_type String?              @db.VarChar(120)
  attachment_size      Int?
  linked_circular_id   String?
  total_recipients     Int                  @default(0)
  read_count           Int                  @default(0)
  consent_count        Int                  @default(0)
  created_by           String?
  published_at         DateTime?
  archived_at          DateTime?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

