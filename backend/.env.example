# Server
NODE_ENV=development
PORT=3000

# Database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silveroak_placement
DATABASE_URL=postgresql://postgres:root@localhost:5432/silveroak_placement

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# CORS — comma-separated list of allowed browser origins (portal frontend + PlaceReady web console
# + any dev origins). Native/Flutter clients send no Origin and are never gated by CORS.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:5174

# Public base URL of this API (used for the OpenAPI `servers` entry consumed by Flutter/codegen).
API_PUBLIC_URL=http://localhost:3000

# Default Tenant
DEFAULT_TENANT_SLUG=silver-oak-university

# CRM Student Signup
CRM_STUDENT_DETAIL_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetStudentDetailByEnrollmentNo
CRM_INSTITUTE_LIST_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetInstituteList
CRM_COURSE_LIST_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetCourseList
CRM_BRANCH_LIST_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetBranchList
CRM_DEPARTMENT_LIST_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetAllDepartments
CRM_EMPLOYEE_LIST_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetEmployeesList
CRM_EMPLOYEE_DETAIL_URL=http://115.244.149.106:44326/api/CRMAPIStudent/GetEmployeeDetail
CRM_API_KEY=slkdjfiok;dfposdjfpkjoidshd -123
STUDENT_SIGNUP_OTP=000000
STUDENT_SIGNUP_SESSION_TTL_MINUTES=10

# Email (ZeptoMail) — signup OTP delivery. MAIL_ZEPTO_TOKEN is the full "Zoho-enczapikey …" header value
# and is a SECRET: set it in .env only, never commit it. When empty, real OTP emails are not sent (dev uses
# the static STUDENT_SIGNUP_OTP above; production refuses to issue an OTP).
MAIL_ZEPTO_URL=https://api.zeptomail.in/v1.1/email
MAIL_ZEPTO_TOKEN=Zoho-enczapikey <your-zeptomail-send-token>
MAIL_FROM_ADDRESS=noreply@placementcrm.silveroakuni.ac.in
MAIL_FROM_NAME=Silver Oak T&P

# PlaceReady student app webhook (SR 36) — SOU events published / students assigned notify the PlaceReady
# app. The secret must equal PlaceReady's PR_SOU_WEBHOOK_SECRET. Leave both empty to disable.
PLACEREADY_WEBHOOK_URL=http://localhost:4100/api/pr/integrations/sou/events
PLACEREADY_WEBHOOK_SECRET=
